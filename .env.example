# Copy to .env — never commit this file.
# Web-application OAuth client from console.cloud.google.com (see README).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: when set, /widget/week and /events.json require
# "Authorization: Bearer <token>" (Glance sends it via the widget's `headers:`).
# The OAuth pages stay open; they are reachable only through the SSH tunnel.
#GMC_AUTH_TOKEN=
